{
  "manifest_version": 3,
  "name": "智能书签管家",
  "version": "1.0.0",
  "description": "一款用于书签管理和自动检测无效链接的Chrome扩展",
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "webRequest",
    "favicon"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "打开智能书签管家",
    "default_icon": {
      "16": "icons/icon_16x16@2x.png",
      "32": "icons/icon_32x32@2x.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon_16x16@2x.png",
    "32": "icons/icon_32x32@2x.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "profile.html",
        "profile.js",
        "styles.css",
        "echarts.min.js",
        "popup.html",
        "popup.css",
        "popup.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "profile.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
